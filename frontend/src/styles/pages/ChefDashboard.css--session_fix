/* Session Portal - Elite Professional */
.session-portal {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 5vh;
}

.start-duty-card, .active-duty-card {
    background: #0d0d10;
    border: 1px solid #1e1e24;
    border-radius: 32px;
    width: 100%;
    max-width: 480px;
    padding: 4rem;
    box-shadow: 0 40px 100px rgba(0,0,0,0.5);
}

.card-top { text-align: center; margin-bottom: 3rem; }
.duty-icon { font-size: 4rem; margin-bottom: 1.5rem; filter: grayscale(1); }
.card-top h3 { font-size: 1.8rem; font-weight: 800; margin: 0; }
.card-top p { color: #555; margin-top: 0.5rem; font-weight: 500; }

.session-form .input-group { margin-bottom: 1.5rem; }
.session-form label { display: block; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: #444; margin-bottom: 0.6rem; letter-spacing: 1px; }
.session-form input {
    width: 100%;
    background: #000;
    border: 1px solid #1a1a1e;
    padding: 1.2rem;
    border-radius: 12px;
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    transition: 0.3s;
}

.session-form input:focus { border-color: #3b82f6; outline: none; background: #050505; }

.duty-btn {
    width: 100%;
    background: #3b82f6;
    color: #fff;
    border: none;
    height: 64px;
    border-radius: 16px;
    font-weight: 800;
    font-size: 1rem;
    cursor: pointer;
    margin-top: 1rem;
    transition: 0.3s;
}

.duty-btn:hover { background: #2563eb; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3); }

/* Active Card Styles */
.profile-header { display: flex; align-items: center; gap: 2rem; margin-bottom: 3rem; }
.avatar-big {
    width: 80px;
    height: 80px;
    background: #3b82f6;
    color: #fff;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 900;
}

.profile-text h1 { font-size: 2.2rem; font-weight: 800; margin: 0; }
.badge-on-duty { font-size: 0.8rem; color: #10b981; font-weight: 700; margin-top: 4px; display: block; }

.duty-stats {
    background: #000;
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 3rem;
}

.duty-stat { display: flex; justify-content: space-between; padding: 1rem 0; border-bottom: 1px solid #111; }
.duty-stat:last-child { border: none; }
.duty-stat .label { color: #444; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; }
.duty-stat .value { color: #fff; font-weight: 700; }

.end-duty-btn {
    width: 100%;
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.1);
    height: 60px;
    border-radius: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
}

.end-duty-btn:hover { background: #ef4444; color: #fff; }
